# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGO_URI=mongodb://localhost:27017/schemeless_mongodb_api

# Authentication Configuration
# Set to 'firebase' or 'local'
AUTH_TYPE=firebase

# Firebase Authentication Configuration
# Option 1: Use a single JSON string for Firebase service account
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"your-project-id","private_key_id":"your-private-key-id","private_key":"-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n","client_email":"your-client-email@your-project-id.iam.gserviceaccount.com","client_id":"your-client-id","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/your-client-email%40your-project-id.iam.gserviceaccount.com"}

# Option 2: Use individual Firebase credentials (alternative to FIREBASE_CREDENTIALS)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----

# Local Authentication Configuration (JWT)
# Required only when AUTH_TYPE=local
JWT_SECRET=your-super-secret-jwt-key-here

# File Upload Configuration
# Storage provider: 'local', 'cloudinary', 's3'
FILE_UPLOAD_PROVIDER=local

# Local Storage Configuration
LOCAL_UPLOAD_PATH=./uploads
LOCAL_BASE_URL=http://localhost:5000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=uploads
CLOUDINARY_RESOURCE_TYPE=auto
CLOUDINARY_SECURE=true

# AWS S3 Configuration (for future implementation)
AWS_S3_REGION=your-aws-region
AWS_S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# General Upload Settings
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_MIME_TYPES=image/jpeg,image/jpg,image/png,image/gif,image/webp,application/pdf,text/plain,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# RBAC (Role-Based Access Control) Configuration
# The RBAC configuration can now be customized via environment variables
# All RBAC environment variables must be valid JSON strings

# Option 1: Override complete RBAC configuration (replaces all config)
# RBAC_COMPLETE_CONFIG={"default":{"roles":{"admin":{"read":["all","own"],"write":["all","own"],"create":true,"delete":["all","own"]},"user":{"read":["own"],"write":["own"],"create":true,"delete":["own"]}}}}

# Option 2: Override default permissions for all collections
# RBAC_DEFAULT_CONFIG={"roles":{"admin":{"read":["all"],"write":["all"],"create":true,"delete":["all"]},"user":{"read":["own"],"write":["own"],"create":false,"delete":false}}}

# Option 3: Override specific collection configurations
# Override orders collection permissions
# RBAC_ORDERS_CONFIG={"roles":{"admin":{"read":["all","own"],"write":["all","own"],"create":true,"delete":["all","own"]},"user":{"read":["own"],"write":["own"],"create":true,"delete":["own"]},"fieldPermissions":{"user":{"read":["id","userId","status","total","items","createdAt","updatedAt"],"write":["status"]}}}}

# Override users collection permissions
# RBAC_USERS_CONFIG={"roles":{"admin":{"read":["all"],"write":["all"],"create":true,"delete":["all"]},"user":{"read":["own"],"write":["own"],"create":false,"delete":["own"]}}}

# Override products collection permissions
# RBAC_PRODUCTS_CONFIG={"roles":{"admin":{"read":["all","own"],"write":["all","own"],"create":true,"delete":["all","own"]},"user":{"read":["all"],"write":["own"],"create":true,"delete":["own"]}}}

# Override ai-providers collection permissions
# RBAC_AI_PROVIDERS_CONFIG={"roles":{"admin":{"read":["all","own"],"write":["all","own"],"create":true,"delete":["all","own"]},"user":{"read":["own"],"write":["own"],"create":true,"delete":["own"]}}}

# Override public collection permissions
# RBAC_PUBLIC_CONFIG={"roles":{"anonymous":{"read":["all"],"write":false,"create":false,"delete":false}}}

# Additional examples for custom collections:
# RBAC_CUSTOM_COLLECTION_CONFIG={"roles":{"admin":{"read":["all","own"],"write":["all","own"],"create":true,"delete":["all","own"]},"user":{"read":["own"],"write":["own"],"create":true,"delete":["own"]}}}

# Option 4: Granular operation overrides (override single operations while keeping defaults)
# Override specific operations for specific roles in specific collections

# Examples for overriding single operations:
# Disable user delete operation on orders collection (keeps all other defaults)
# RBAC_ORDERS_USER_DELETE=false

# Enable admin to read all products (overwrites ["all","own"] with ["all"])
# RBAC_PRODUCTS_ADMIN_READ=["all"]

# Allow users to create other users (overwrites false with true)
# RBAC_USERS_USER_CREATE=true

# Allow users to write to all fields in orders collection (overwrites specific field list)
# RBAC_ORDERS_USER_FIELDS_WRITE=["id","userId","status","total","items","createdAt","updatedAt"]

# Make ai-providers collection publicly readable
# RBAC_AI_PROVIDERS_ANONYMOUS_READ=["all"]

# Examples for field-level permission overrides:
# RBAC_ORDERS_USER_FIELDS_READ=["id","userId","status","total","items","createdAt","updatedAt"]
# RBAC_ORDERS_USER_FIELDS_WRITE=["status","total"]
# RBAC_PRODUCTS_ADMIN_FIELDS_WRITE=["id","name","price","description","category","stock"]

# Priority order (highest to lowest):
# 1. RBAC_COMPLETE_CONFIG (complete override)
# 2. RBAC_{COLLECTION}_CONFIG (collection-level override)
# 3. RBAC_{COLLECTION}_{ROLE}_{OPERATION} (single operation override)
# 4. RBAC_{COLLECTION}_{ROLE}_FIELDS_{TYPE} (field-level override)
# 5. Default configuration in config/rbac.js

# Notes:
# - Environment variables must be valid JSON strings
# - Use double quotes and escape properly in shell
# - Collection names with dashes (like ai-providers) become underscores (AI_PROVIDERS)
# - Operation values: arrays for read/write, boolean for create/delete
# - Field values: arrays of field names for field permissions
# - If parsing fails, the default configuration in config/rbac.js will be used